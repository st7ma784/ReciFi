[Unit]
Description=ReciFi label print server
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
# lp: /dev/usb/lp0   bluetooth: RFCOMM/BLE via BlueZ
SupplementaryGroups=lp bluetooth
WorkingDirectory=/home/pi/ReciFi
Environment=RECIFI_DATA=/home/pi/.local/share/recifi
ExecStart=/home/pi/ReciFi/.venv/bin/python -m recifi --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
