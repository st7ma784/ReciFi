# The docs site. GitHub Pages builds this via .github/workflows/pages.yml, so we
# are not restricted to the `github-pages` gem's allowlist and can pin the theme
# directly -- faster and more reproducible than fetching a remote theme.
#
# Preview locally:
#   cd docs && bundle install && bundle exec jekyll serve
source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "just-the-docs", "~> 0.10"

# Dropped from the Ruby stdlib in 3.4; harmless on 3.3.
gem "csv"
gem "base64"
gem "bigdecimal"
